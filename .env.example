# OpenRouter API key — required for AI-enhanced analysis (openai/gpt-oss-120b:free)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: Register at https://www.contrataciones.gov.py/datos/
# to get customer_key and customer_secret, then base64 encode "key:secret"
DNCP_REQUEST_TOKEN=

# Optional: LLM model for web scanner extraction (default: anthropic/claude-3.5-sonnet)
WEB_SCANNER_MODEL=nvidia/nemotron-nano-9b-v2

# Set to "true" during demo if APIs are down
MOCK_MODE=false

# Logging: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=DEBUG
